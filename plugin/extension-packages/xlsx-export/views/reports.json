{
  "id": "xlsx-reports",
  "label": "XLSX 보고서",
  "icon": "sheet",
  "type": "table",
  "component": "",
  "query": {
    "folders": [
      "work/*"
    ],
    "exclude": [
      "*.base"
    ],
    "where": [
      {
        "field": "workflowId",
        "op": "notEmpty",
        "value": null
      }
    ],
    "sort": {
      "field": "",
      "source": "mtime",
      "desc": true
    },
    "limit": 2000
  },
  "columns": [
    {
      "field": "id",
      "label": "ID",
      "source": "",
      "type": "text",
      "width": 100
    },
    {
      "field": "title",
      "label": "제목",
      "source": "",
      "type": "text",
      "width": 0
    },
    {
      "field": "status",
      "label": "상태",
      "source": "",
      "type": "badge",
      "width": 90
    },
    {
      "field": "projectId",
      "label": "프로젝트",
      "source": "",
      "type": "text",
      "width": 120
    }
  ],
  "groupBy": "status",
  "actions": [
    "export"
  ],
  "empty": "내보낼 작업이 없습니다."
}
