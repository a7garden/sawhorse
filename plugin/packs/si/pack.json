{
  "id": "si",
  "name": "SI 업무",
  "version": "1.0.0",
  "author": "won",
  "icon": "briefcase",
  "description": "일과 루틴, 업무일지·보고, 개념 정리와 프로젝트 문서화. 작업 진행과 승인은 앱의 공통 워크플로우를 사용합니다.",
  "skills": [
    "morning",
    "lunch",
    "evening",
    "daily-log",
    "daily-report",
    "wiki",
    "init-vault",
    "setup",
    "vault-tidy",
    "project-doc",
    "codebase-docs",
    "issues"
  ],
  "workspace": {
    "folders": [
      "템플릿",
      "일지",
      "프로젝트",
      "개념",
      "첨부/스크린샷",
      "첨부/다이어그램"
    ],
    "files": [
      {
        "src": "templates/일지.md",
        "dest": "템플릿/일지.md"
      },
      {
        "src": "templates/프로젝트.md",
        "dest": "템플릿/프로젝트.md"
      },
      {
        "src": "templates/개념.md",
        "dest": "템플릿/개념.md"
      },
      {
        "src": "templates/기능분석.md",
        "dest": "템플릿/기능분석.md"
      },
      {
        "src": "templates/회의.md",
        "dest": "템플릿/회의.md"
      },
      {
        "src": "assets/bases/일지.base",
        "dest": "일지/일지.base"
      },
      {
        "src": "assets/bases/개념.base",
        "dest": "개념/개념.base"
      },
      {
        "src": "assets/bases/프로젝트.base",
        "dest": "프로젝트/프로젝트.base"
      },
      {
        "src": "assets/대시보드.md",
        "dest": "대시보드.md"
      }
    ]
  },
  "actions": [
    {
      "id": "morning",
      "label": "아침 브리핑",
      "description": "오늘 일지 준비 + 어제 할 일 이월 + 어제 요약 + 볼트 빠른 정리",
      "prompt": "/{{ns}}:morning",
      "cwd": "workspace",
      "featured": true,
      "schedule": {
        "kind": "weekdays",
        "time": "09:00"
      }
    },
    {
      "id": "lunch",
      "label": "오전 결산",
      "description": "오늘 할 일 대 오전 세션 대조 + 볼트 진단 (읽기 전용)",
      "prompt": "/{{ns}}:lunch",
      "cwd": "workspace",
      "featured": true,
      "schedule": {
        "kind": "weekdays",
        "time": "12:30"
      }
    },
    {
      "id": "evening",
      "label": "퇴근 정산",
      "description": "체크 확정 → 업무기록 작성 → 보고서 출력 → 내일 할 일 정리 → 볼트 정리",
      "prompt": "/{{ns}}:evening",
      "cwd": "workspace",
      "featured": true,
      "schedule": {
        "kind": "weekdays",
        "time": "18:00"
      }
    },
    {
      "id": "daily-log",
      "label": "업무일지 갱신",
      "description": "오늘 세션을 분석해 일지의 업무기록 자동 영역만 다시 쓴다",
      "prompt": "/{{ns}}:daily-log {{note}}",
      "cwd": "workspace",
      "params": [
        {
          "key": "note",
          "type": "text",
          "label": "덧붙일 구두 업무 (선택)"
        }
      ]
    },
    {
      "id": "daily-report",
      "label": "업무 보고 만들기",
      "description": "그날 작업을 보고 형식 코드블록으로 출력 (복붙용)",
      "prompt": "/{{ns}}:daily-report {{note}}",
      "cwd": "workspace",
      "params": [
        {
          "key": "note",
          "type": "text",
          "label": "덧붙일 구두 업무 (선택)"
        }
      ]
    },
    {
      "id": "design",
      "label": "이슈 설계",
      "description": "선택한 작업의 고정 워크플로우에 맞춰 설계 산출물을 작성합니다.",
      "prompt": "/{{ns}}:issues 설계 {{ids}}",
      "cwd": "project",
      "params": [
        {
          "key": "ids",
          "type": "list",
          "label": "이슈 ID (비우면 전체)"
        },
        {
          "key": "project",
          "type": "project",
          "label": "프로젝트"
        }
      ]
    },
    {
      "id": "implement",
      "label": "이슈 실행",
      "description": "호스트가 허용한 단계와 범위에서 작업을 수행하고 검증 근거를 남깁니다.",
      "prompt": "/{{ns}}:issues 실행 {{ids}}",
      "cwd": "project",
      "params": [
        {
          "key": "ids",
          "type": "list",
          "label": "이슈 ID (비우면 승인된 전체)"
        },
        {
          "key": "project",
          "type": "project",
          "label": "프로젝트"
        }
      ]
    },
    {
      "id": "milestone",
      "label": "마일스톤 계획",
      "description": "목표·완료 기준·기한을 정리해 앱의 캘린더 마일스톤으로 연결합니다.",
      "prompt": "/{{ns}}:issues 마일스톤 {{name}}",
      "cwd": "workspace",
      "params": [
        {
          "key": "name",
          "type": "text",
          "label": "마일스톤 이름 (선택)"
        }
      ]
    },
    {
      "id": "wiki",
      "label": "개념 정리",
      "description": "문서에 나온 개념을 위키링크로 연결하고 없는 개념 문서를 만든다",
      "prompt": "/{{ns}}:wiki {{topic}}",
      "cwd": "workspace",
      "params": [
        {
          "key": "topic",
          "type": "text",
          "label": "정리할 개념/문서 (선택)"
        }
      ]
    },
    {
      "id": "project-doc",
      "label": "프로젝트 문서 만들기",
      "description": "제안서와 코드베이스에서 프로젝트 지식 문서를 만듭니다.",
      "prompt": "/{{ns}}:project-doc {{source}}",
      "cwd": "workspace",
      "params": [
        {
          "key": "source",
          "type": "text",
          "label": "제안서 경로 / 코드베이스 경로"
        }
      ]
    },
    {
      "id": "codebase-docs",
      "label": "코드베이스 문서화",
      "description": "기능별 분석 문서를 mermaid 다이어그램과 함께 만든다",
      "prompt": "/{{ns}}:codebase-docs {{target}}",
      "cwd": "project",
      "params": [
        {
          "key": "target",
          "type": "text",
          "label": "문서화할 범위 (선택)"
        },
        {
          "key": "project",
          "type": "project",
          "label": "프로젝트"
        }
      ]
    },
    {
      "id": "vault-tidy",
      "label": "볼트 정리",
      "description": "일지·지식 문서의 첨부와 링크를 점검하고 정리합니다.",
      "prompt": "/{{ns}}:vault-tidy",
      "cwd": "workspace"
    },
    {
      "id": "init-vault",
      "label": "볼트 초기화",
      "description": "SI 팩이 선언한 폴더·템플릿을 준비합니다. Obsidian 설정은 사용하는 경우에만 적용합니다.",
      "prompt": "/{{ns}}:init-vault",
      "cwd": "workspace"
    },
    {
      "id": "setup",
      "label": "환경 진단",
      "description": "볼트 경로·Node·pandoc·훅·MCP 설정을 점검하고 보고한다",
      "prompt": "/{{ns}}:setup",
      "cwd": "workspace"
    }
  ],
  "views": [
    {
      "id": "todos",
      "label": "할 일",
      "icon": "square-check-big",
      "group": "work",
      "type": "native",
      "component": "todos"
    },
    {
      "id": "concepts",
      "label": "개념",
      "icon": "book-marked",
      "group": "vault",
      "type": "notes",
      "query": {
        "folders": [
          "개념"
        ],
        "exclude": [
          "*.base"
        ],
        "sort": {
          "field": "",
          "source": "title",
          "desc": false
        }
      },
      "columns": [
        {
          "field": "",
          "source": "title",
          "label": "개념"
        },
        {
          "field": "domain",
          "label": "분류",
          "type": "badge",
          "width": 110
        },
        {
          "field": "aliases",
          "label": "다른 이름",
          "type": "list"
        },
        {
          "field": "sources",
          "label": "출처",
          "type": "list"
        },
        {
          "field": "",
          "source": "mtime",
          "label": "수정",
          "type": "date",
          "width": 110
        }
      ],
      "groupBy": "domain",
      "actions": [
        "wiki"
      ],
      "empty": "개념 문서가 아직 없습니다. '개념 정리'를 실행하면 문서에 나온 용어부터 만듭니다."
    },
    {
      "id": "vault",
      "label": "점검",
      "icon": "folder-search",
      "group": "vault",
      "type": "native",
      "component": "vault"
    }
  ]
}
