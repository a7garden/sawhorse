formulas:
  진행: 'if(state == "closed", status + " (closed)", status)'
filters:
  and:
    - type == "이슈"
    - file.inFolder("프로젝트/<프로젝트명>/이슈")
properties:
  file.name: { displayName: 이슈 }
  id: { displayName: ID }
  issue_type: { displayName: 유형 }
  execution_type: { displayName: 처리 유형 }
  labels: { displayName: 레이블 }
  milestone: { displayName: 마일스톤 }
  priority: { displayName: 중요도 }
  status: { displayName: 워크플로 }
  state: { displayName: 상태 }
  assignees: { displayName: 담당 }
  due: { displayName: 목표일 }
  url: { displayName: 화면 }
  approve: { displayName: 승인 }
  commits: { displayName: 커밋 }
  github_number: { displayName: "GitHub #" }
  formula.진행: { displayName: 진행 }
views:
  - type: table
    name: 열린 이슈
    filters: { and: ['state == "open"'] }
    order: [id, file.name, issue_type, milestone, priority, formula.진행, assignees]
    sort: [{ property: priority, direction: DESC }, { property: id, direction: ASC }]
  - type: table
    name: 승인대기
    filters: { and: ['status == "승인대기"'] }
    order: [id, file.name, milestone, priority, approve]
  - type: table
    name: 실행대기
    filters: { and: ['approve == true', 'status == "승인"'] }
    order: [id, file.name, milestone, priority, depends_on]
  - type: table
    name: 마일스톤별
    order: [id, file.name, issue_type, priority, formula.진행]
    groupBy: { property: milestone, direction: ASC }
  - type: table
    name: 화면별
    order: [id, file.name, milestone, priority, formula.진행]
    groupBy: { property: url, direction: ASC }
  - type: table
    name: 완료
    filters: { and: ['status == "완료"'] }
    order: [id, file.name, status, verified, commits]
