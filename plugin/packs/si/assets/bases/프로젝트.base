filters:
  and:
    - not:
        - file.inFolder("템플릿")
    - or:
        - type == "프로젝트"
        - type == "연구"
        # 이름을 바꾸기 전 만든 허브 노트. 이관 전까지 목록에서 사라지지 않게 한다.
        - type == "사업"
properties:
  file.name:
    displayName: 프로젝트
  status:
    displayName: 상태
  client:
    displayName: 발주처
  period:
    displayName: 기간
  codebase:
    displayName: 코드베이스
views:
  - type: table
    name: 진행중
    filters:
      and:
        - status == "진행중"
    order:
      - file.name
      - client
      - period
      - vcs
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 전체
    order:
      - file.name
      - type
      - status
      - client
      - period
      - parent
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
