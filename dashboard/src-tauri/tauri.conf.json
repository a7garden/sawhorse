{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sawhorse 대시보드",
  "version": "0.1.0",
  "identifier": "com.a7garden.sawhorse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sawhorse 대시보드",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../.claude-plugin": ".claude-plugin",
      "../../packs": "packs",
      "../../skills": "skills"
    }
  }
}
