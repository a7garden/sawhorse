formulas:
  진행: 'if(status == "구현완료", status + " (" + verified + ")", status)'
filters:
  and:
    - type == "개선"
    - file.inFolder("사업/<사업명>/개선")
properties:
  file.name:
    displayName: 문제
  id:
    displayName: ID
  priority:
    displayName: 중요도
  url:
    displayName: 화면
  screen:
    displayName: 화면 영역
  category:
    displayName: 구분
  origin:
    displayName: 출처
  status:
    displayName: 상태
  approve:
    displayName: 승인
  approved:
    displayName: 승인일
  verified:
    displayName: 검증
  base:
    displayName: 배치 기준
  commits:
    displayName: 커밋
  depends_on:
    displayName: 선행
  dependents:
    displayName: 후행
  raised:
    displayName: 접수일
  item:
    displayName: 항목
  action:
    displayName: 조치
  due:
    displayName: 완료일
  remark:
    displayName: 비고
  formula.진행:
    displayName: 상태
views:
  - type: table
    name: 승인대기
    filters:
      and:
        - status == "승인대기"
    order:
      - id
      - file.name
      - priority
      - url
      - category
      - approve
    sort:
      - property: priority
        direction: DESC
      - property: id
        direction: ASC
  - type: table
    name: 구현대기
    filters:
      and:
        - approve == true
        - status == "승인"
    order:
      - id
      - file.name
      - priority
      - url
      - category
      - depends_on
    sort:
      - property: priority
        direction: DESC
      - property: id
        direction: ASC
  - type: table
    name: 진행중
    filters:
      or:
        - status == "구현중"
        - status == "부분구현"
    order:
      - id
      - file.name
      - priority
      - url
      - status
      - base
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 제안
    filters:
      and:
        - status == "제안"
    order:
      - id
      - file.name
      - priority
      - url
      - category
      - origin
    sort:
      - property: priority
        direction: DESC
      - property: id
        direction: ASC
  - type: table
    name: 미해결
    filters:
      and:
        - status != "구현완료"
        - status != "반려"
    order:
      - id
      - file.name
      - priority
      - url
      - category
      - status
    sort:
      - property: priority
        direction: DESC
      - property: id
        direction: ASC
  - type: table
    name: 우선순위별
    filters:
      and:
        - status != "구현완료"
        - status != "반려"
    order:
      - id
      - file.name
      - url
      - category
      - formula.진행
    groupBy:
      property: priority
      direction: DESC
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 검증대기
    filters:
      and:
        - status == "구현완료"
        - verified != "확인"
    order:
      - id
      - file.name
      - url
      - commits
      - dependents
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 구현완료
    filters:
      and:
        - status == "구현완료"
    order:
      - id
      - file.name
      - category
      - verified
      - commits
      - dependents
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 보류반려
    filters:
      or:
        - status == "보류"
        - status == "반려"
    order:
      - id
      - file.name
      - priority
      - url
      - status
      - category
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 인수인계유래
    filters:
      and:
        - origin == "인수인계"
    order:
      - id
      - file.name
      - formula.진행
      - commits
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 화면별
    order:
      - id
      - file.name
      - priority
      - category
      - formula.진행
    groupBy:
      property: url
      direction: ASC
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 배치별
    filters:
      and:
        - base != ""
    order:
      - id
      - file.name
      - commits
      - dependents
    groupBy:
      property: base
      direction: ASC
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 전체
    order:
      - id
      - file.name
      - priority
      - url
      - category
      - origin
      - formula.진행
      - approve
      - commits
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 보고용
    order:
      - raised
      - screen
      - item
      - file.name
      - category
      - action
      - due
      - priority
      - formula.진행
      - remark
    sort:
      - property: id
        direction: ASC
